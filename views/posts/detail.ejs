<h2><%= post.title %></h2>
<p>작성자: <%= post.author %></p>
<p><%= post.content %></p>

<% if (user && user.username === post.author) { %>
  <a href="/posts/<%= post.id %>/edit">수정</a>
  <form method="post" action="/posts/<%= post.id %>/delete">
    <button>삭제</button>
  </form>
<% } %>

<a href="/posts">목록으로</a>